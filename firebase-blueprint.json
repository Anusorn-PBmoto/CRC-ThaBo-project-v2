{
  "entities": {
    "product": {
      "title": "Product",
      "description": "Motorcycle spare part and inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barcode": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "unit": { "type": "string", "maxLength": 30 },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string", "maxLength": 80 },
        "brand": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 100 },
        "actualQty": { "type": "number" },
        "systemQty": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "checked", "discrepancy"] },
        "minStock": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "unit", "costPrice", "sellingPrice"]
    },
    "auditSession": {
      "title": "AuditSession",
      "description": "Inventory stock audit session record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "zone": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "totalItems": { "type": "number" },
        "checkedItems": { "type": "number" },
        "discrepancyCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["code", "zone", "status"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Log record for inventory audit and stock adjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 100 },
        "productName": { "type": "string", "maxLength": 150 },
        "diff": { "type": "number" },
        "previousQty": { "type": "number" },
        "newQty": { "type": "number" },
        "action": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "note": { "type": "string", "maxLength": 200 }
      },
      "required": ["productName", "diff", "action", "timestamp"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Buy and Sell transactions for automatic stock adjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["sale", "purchase"] },
        "productId": { "type": "string", "maxLength": 100 },
        "productName": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "customerOrSupplier": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["type", "productId", "productName", "quantity", "createdAt"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer and member profile with tier and accumulated spend",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "general"] },
        "vehiclePlate": { "type": "string", "maxLength": 100 },
        "vehicleModel": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 300 },
        "totalSpend": { "type": "number" },
        "purchaseCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "phone", "grade"]
    },
    "customerTier": {
      "title": "CustomerTier",
      "description": "Customer tier settings and default discount percentage",
      "type": "object",
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "general"] },
        "name": { "type": "string", "maxLength": 100 },
        "discountPercent": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 },
        "badgeColor": { "type": "string", "maxLength": 100 }
      },
      "required": ["grade", "name", "discountPercent"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Motorcycle parts and inventory catalog"
    },
    "/audit_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/auditSession" },
      "description": "Stock audit sessions"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/auditLog" },
      "description": "Audit logs and history records"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transaction" },
      "description": "Buy and sell transaction history"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/customer" },
      "description": "Customer directory with grading and loyalty stats"
    },
    "/settings/customer_tiers": {
      "schema": { "$ref": "#/entities/customerTier" },
      "description": "Customer discount tiers configuration"
    }
  }
}
